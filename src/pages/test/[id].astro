---
import Layout from '../../layouts/Layout.astro';
import Crumbs from '../../components/Crumbs.astro';
import Player from '../../components/Player.astro';
import { allTests, questionsFor, hasCustom, examMap, CFG } from '../../lib/data.js';
import { u } from '../../lib/url.js';
export function getStaticPaths() {
  return allTests.map(t => ({ params: { id: t.id }, props: { t } }));
}
const { t } = Astro.props;
const qs = questionsFor(t.id);
const exam = examMap[t.exam];
const abs = p => new URL(u(p), Astro.site).href;
const schema = [
  { '@context': 'https://schema.org', '@type': 'Quiz', name: t.title, about: { '@type': 'Thing', name: exam.name }, educationalLevel: 'Competitive exam preparation', inLanguage: ['en', 'hi'] },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [['Home', '/'], [exam.name, `/exams/${exam.slug}/`], [t.title, `/test/${t.id}/`]].map(([name, p], i) => ({ '@type': 'ListItem', position: i + 1, name, item: abs(p) })) },
];
---
<Layout title={`${t.title} Online Test`} description={`Attempt ${t.title} online in Hindi or English. ${qs.length} questions, ${CFG.duration} minutes, instant score and solutions.`} path={`/test/${t.id}/`} schema={schema}>
  <Crumbs items={[{ n: 'Home', u: u('/') }, { n: exam.name, u: u(`/exams/${exam.slug}/`) }, { n: t.title }]} />
  <Player t={t} qs={qs} back={u(`/exams/${t.exam}/`)} backLabel={`More ${exam.name} tests`} href={u(`/test/${t.id}/`)} sample={!hasCustom(t.id)} />
</Layout>
