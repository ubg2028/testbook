---
import Layout from '../../layouts/Layout.astro';
import { exams, series, cats } from '../../lib/data.js';
import { u } from '../../lib/url.js';
---
<Layout title="Online Test Series" description="Full length mock test series for government exams with negative marking, instant results and solutions." path="/test-series/">
  <section class="wrap sec">
    <h1>Test series</h1>
    <p class="muted" style="max-width:680px">Full length mock tests for every exam, with negative marking and instant analysis. After each test, follow our <a href={u('/blog/mock-test-analysis-method/')} style="color:var(--brand);text-decoration:underline">30 minute analysis routine</a>, and practise on real <a href={u('/previous-year-papers/')} style="color:var(--brand);text-decoration:underline">previous year papers</a> too. Questions are prepared and checked as described in our <a href={u('/editorial-policy/')} style="color:var(--brand);text-decoration:underline">editorial policy</a>.</p>
    {cats.map(c => (
      <div class="cat">
        <h3>{c}</h3>
        <div class="grid">
          {series.filter(s => exams.find(e => e.slug === s.exam).cat === c).map(s => (
            <a class="card" href={u(`/exams/${s.exam}/#test-series`)}>
              <h3>{s.title}</h3>
              <p class="muted" style="margin:0">{s.tests.length} full mock tests</p>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>
</Layout>
