---
import '../styles/global.css';
import site from '../data/site.json';
import { u } from '../lib/url.js';
const { title, description = site.tagline, path = '/', schema, ogType = 'website' } = Astro.props;
const full = title === site.name ? title : `${title} | ${site.name}`;
const canonical = new URL(u(path), Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#2447d6" />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:url" content={canonical} />
  <script is:inline>
    (function(){var t;try{t=localStorage.getItem('theme')}catch(e){}if(!t)t=matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light';document.documentElement.dataset.theme=t})();
  </script>
  <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
  <link rel="apple-touch-icon" href={u('/icon-192.png')} />
  {site.adsense.client && <meta name="google-adsense-account" content={site.adsense.client} />}
  <link rel="manifest" href={u('/manifest.webmanifest')} />
  <link rel="alternate" type="application/rss+xml" title={`${site.name} blog`} href={u('/rss.xml')} />
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="top">
    <div class="wrap bar">
      <a class="logo" href={u('/')} aria-label={`${site.name} home`}>
        <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#2447d6"/><path d="M9 23 16 8l7 15M12 18h8" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {site.name}
      </a>
      <nav id="nav" aria-label="Main">
        <a href={u('/exams/')}>Exams</a>
        <a href={u('/test-series/')}>Test series</a>
        <a href={u('/previous-year-papers/')}>Previous year papers</a>
        <a href={u('/daily-quiz/')}>Daily quiz</a>
        <a href={u('/blog/')}>Blog</a>
        <a href={u('/dashboard/')}>My progress</a>
      </nav>
      <button class="icon-btn" id="theme" type="button" aria-label="Switch light or dark mode">
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <button class="icon-btn menu-btn" id="menu" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav">
        <svg class="bars" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg class="x" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="foot">
    <div class="wrap">
      <div class="fcols">
        <div>
          <h2>{site.name}</h2>
          <p>{site.tagline}</p>
        </div>
        <nav aria-label="Practice">
          <h2>Practice</h2>
          <a href={u('/exams/')}>All exams</a>
          <a href={u('/previous-year-papers/')}>Previous year papers</a>
          <a href={u('/test-series/')}>Test series</a>
          <a href={u('/daily-quiz/')}>Daily quiz</a>
          <a href={u('/blog/')}>Blog</a>
        </nav>
        <nav aria-label="About Abhyas">
          <h2>About Abhyas</h2>
          <a href={u('/about/')}>About us</a>
          <a href={u('/team/')}>Our team</a>
          <a href={u('/editorial-policy/')}>Editorial policy</a>
          <a href={u('/contact/')}>Contact</a>
          {site.telegram && <a href={site.telegram} rel="noopener">Telegram</a>}
          {site.whatsapp && <a href={site.whatsapp} rel="noopener">WhatsApp channel</a>}
        </nav>
        <nav aria-label="Legal">
          <h2>Legal</h2>
          <a href={u('/privacy-policy/')}>Privacy policy</a>
          <a href={u('/terms/')}>Terms of use</a>
          <a href={u('/disclaimer/')}>Disclaimer</a>
          <a href={u('/dmca/')}>Copyright and DMCA</a>
          <a href={u('/sitemap/')}>Sitemap</a>
        </nav>
      </div>
      <div class="fbase">
        <p>{site.name} is an independent practice platform. It is not affiliated with any exam conducting body.</p>
        <p>Your test progress is saved on this device only. <button class="btn sm ghost" id="install" type="button" hidden>Install app</button></p>
        <p>&copy; {new Date().getFullYear()} {site.name}. All rights reserved.</p>
      </div>
    </div>
  </footer>
  <a id="resume" class="resume" href="#resume" hidden>Back to test <span id="rt"></span></a>
  <button class="icon-btn fab" id="totop" type="button" aria-label="Back to top">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
  </button>
  <script is:inline>
    (function(){
      var r=document.documentElement,nav=document.getElementById('nav'),mb=document.getElementById('menu'),tb=document.getElementById('theme');
      function setMenu(o){nav.classList.toggle('open',o);mb.setAttribute('aria-expanded',o)}
      mb.addEventListener('click',function(){setMenu(!nav.classList.contains('open'))});
      nav.addEventListener('click',function(e){if(e.target.closest('a'))setMenu(false)});
      document.addEventListener('keydown',function(e){if(e.key==='Escape')setMenu(false)});
      document.addEventListener('click',function(e){if(!e.target.closest('.top'))setMenu(false)});
      tb.addEventListener('click',function(){
        var t=r.dataset.theme==='dark'?'light':'dark';
        var apply=function(){r.dataset.theme=t;try{localStorage.setItem('theme',t)}catch(e){}document.querySelector('meta[name=theme-color]').content=t==='dark'?'#121a27':'#2447d6'};
        if(matchMedia('(prefers-reduced-motion:reduce)').matches){apply();return}
        if(!document.startViewTransition){r.classList.add('tfade');apply();setTimeout(function(){r.classList.remove('tfade')},450);return}
        var b=tb.getBoundingClientRect(),x=b.left+b.width/2,y=b.top+b.height/2,rad=Math.hypot(Math.max(x,innerWidth-x),Math.max(y,innerHeight-y));
        r.classList.add('tvt');
        var vt=document.startViewTransition(apply);
        vt.ready.then(function(){r.animate({clipPath:['circle(0px at '+x+'px '+y+'px)','circle('+rad+'px at '+x+'px '+y+'px)']},{duration:550,easing:'cubic-bezier(.4,0,.2,1)',pseudoElement:'::view-transition-new(root)'})});
        vt.finished.then(function(){r.classList.remove('tvt')},function(){r.classList.remove('tvt')});
      });
      var dp,ib=document.getElementById('install');
      addEventListener('beforeinstallprompt',function(e){e.preventDefault();dp=e;ib.hidden=false});
      ib.addEventListener('click',function(){if(dp){dp.prompt();ib.hidden=true}});
    })();
  </script>
  <script is:inline>
    (function(){
      var up=document.getElementById('totop'),tk=0;
      addEventListener('scroll',function(){if(tk)return;tk=requestAnimationFrame(function(){tk=0;up.classList.toggle('show',scrollY>500)})},{passive:true});
      up.addEventListener('click',function(){scrollTo({top:0,behavior:matchMedia('(prefers-reduced-motion:reduce)').matches?'auto':'smooth'})});
      var ra=document.getElementById('resume'),rt=document.getElementById('rt');
      function chk(){
        var a;try{a=JSON.parse(localStorage.getItem('abhyas:active'))}catch(e){}
        if(!a||a.end<=Date.now()||location.pathname===a.h){ra.hidden=true;return}
        var sec=Math.round((a.end-Date.now())/1000),m=Math.floor(sec/60),s=sec%60;
        ra.href=a.h+'#resume';rt.textContent=(m<10?'0':'')+m+':'+(s<10?'0':'')+s;ra.hidden=false;
      }
      chk();setInterval(chk,1000);
    })();
  </script>
  {site.adsense.client && <script is:inline define:vars={{ c: site.adsense.client }}>
    addEventListener('load', function () { setTimeout(function () { var s = document.createElement('script'); s.async = true; s.crossOrigin = 'anonymous'; s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + c; document.head.appendChild(s); }, 2000); });
  </script>}
  <script is:inline define:vars={{ sw: u('/sw.js') }}>
    if ('serviceWorker' in navigator) addEventListener('load', () => navigator.serviceWorker.register(sw).catch(() => {}));
  </script>
</body>
</html>
